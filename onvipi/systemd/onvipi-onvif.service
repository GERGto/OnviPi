[Unit]
Description=OnviPi ONVIF server (device, media, motion events)
After=network-online.target onvipi-go2rtc.service
Wants=network-online.target

[Service]
User=onvipi
SupplementaryGroups=video
# /run/onvipi: motion markers for the recording service
RuntimeDirectory=onvipi
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/python3 /opt/onvipi/onvipi_onvif.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
