[Unit]
Description=OnviPi video stream (go2rtc: RTSP, WebRTC)
After=network.target

[Service]
User=onvipi
SupplementaryGroups=video audio
ExecStartPre=+/usr/bin/python3 /opt/onvipi/onvipi_camera.py --ensure --render
ExecStart=/usr/local/bin/go2rtc -config /etc/onvipi/go2rtc.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
