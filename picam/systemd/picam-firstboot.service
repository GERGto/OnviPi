[Unit]
Description=PiCam Ersteinrichtung (Hostname, Kamera-Passwort, Webcam-Erkennung)
# Nur im fertigen Image aktiviert; läuft einmal, solange noch keine picam.conf existiert
ConditionPathExists=!/etc/picam/picam.conf
After=local-fs.target systemd-udevd.service
Before=NetworkManager.service avahi-daemon.service go2rtc.service picam-onvif.service picam-wsd.service picam-wifi.service picam-mqtt.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/picam/setup/firstboot.sh
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
